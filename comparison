results <- data.frame(
  month     = 1:12,
  Actual    = as.numeric(test),
  ARIMA     = pred_arima,
  Chronos2  = pred_chronos,
  TimesFM25 = pred_timesfm,
  TimesFM3  = pred_timesfm3
)

results_long <- pivot_longer(results, -c(month, Actual),
                             names_to = "Model", values_to = "value")

ggplot(results_long, aes(month, value, color = Model)) +
  geom_line(linewidth = 1) +
  geom_point(size = 2) +
  geom_line(data = results, aes(month, Actual),
            color = "black", linewidth = 1.2, linetype = "dashed",
            inherit.aes = FALSE) +
  scale_x_continuous(breaks = 1:12) +
  labs(title = "1960 forecasts vs actual (black dashed)",
       x = "Month (1960)", y = "Passengers (thousands)")

# Accuracy metrics
mape <- function(actual, pred) mean(abs((actual - pred) / actual)) * 100
rmse <- function(actual, pred) sqrt(mean((actual - pred)^2))
mae  <- function(actual, pred) mean(abs(actual - pred))

models <- c("ARIMA", "Chronos2", "TimesFM25", "TimesFM3")
data.frame(
  Model = models,
  MAPE  = sapply(models, function(m) mape(results$Actual, results[[m]])),
  MAE   = sapply(models, function(m) mae(results$Actual,  results[[m]])),
  RMSE  = sapply(models, function(m) rmse(results$Actual, results[[m]])),
  row.names = NULL
) |> print(digits = 3)
