img_prep <- function(path, max_side = 1400) {
  img  <- image_read(path)
  info <- image_info(img)[1, ]
  
  if (max(info$width, info$height) > max_side) {
    img <- image_resize(img, paste0(max_side, "x", max_side))
  }
  
  out <- tempfile(fileext = ".png")
  image_write(img, out, format = "png")
  out
}
vision_ask <- function(image, prompt,
                       model  = "qwen3.8:27b",
                       schema = NULL,
                       temperature = 0) {
  
  img_path <- img_prep(image)
  
  body <- list(
    model      = model,
    prompt     = prompt,
    images     = list(base64encode(img_path)),
    stream     = FALSE,
    keep_alive = "10m",
    think      = FALSE,
    options    = list(
      temperature = temperature,
      num_ctx     = 8192,
      num_predict = 2048
    )
  )
  if (!is.null(schema)) body$format <- schema
  
  resp <- request("http://localhost:11434/api/generate") |>
    req_body_json(body, auto_unbox = TRUE) |>
    req_timeout(900) |>
    req_error(body = function(resp) resp_body_string(resp)) |>
    req_perform() |>
    resp_body_json()
  
  out <- resp$response
  if (is.null(schema)) out else fromJSON(out)
}
