chronos <- import("chronos")
pd      <- import("pandas", convert = FALSE)

# Build the context data frame 
context_py <- pd$DataFrame(dict(
  item_id   = rep("air", length(train)),
  timestamp = pd$date_range(start = "1949-01-01",
                            periods = length(train),
                            freq = "MS"),        
  target    = as.numeric(train)
))

# Load the pre-trained model 
pipeline <- chronos$Chronos2Pipeline$from_pretrained(
  "amazon/chronos-2",
  device_map = "cpu"       
)

# Zero-shot forecast
pred_chronos_df <- pipeline$predict_df(
  context_py,
  prediction_length = 12L,                    
  quantile_levels   = list(0.1, 0.5, 0.9),
  id_column         = "item_id",
  timestamp_column  = "timestamp",
  target            = "target"
)

