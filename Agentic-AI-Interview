library(ollamar)
library(ellmer)

new_chat <- function(system_prompt = NULL) {
  chat_ollama(model = MODEL, system_prompt = system_prompt)
}

# airquality
monthly_means <- function(column) {
  if (!column %in% c("Ozone", "Solar.R", "Wind", "Temp")) {
    return(paste("Unknown column:", column, "- use Ozone, Solar.R, Wind or Temp"))
  }
  m <- tapply(airquality[[column]], airquality$Month, mean, na.rm = TRUE)
  paste(paste0("Month ", names(m), ": ", round(m, 2)), collapse = "\n")
}

tool_monthly_means <- tool(
  monthly_means,
  description = "Returns the mean of one airquality column for each month
    (5 = May, 6 = June, 7 = July, 8 = August, 9 = September).",
  arguments = list(
    column = type_string("Column name: one of Ozone, Solar.R, Wind, Temp")
  ),
  name = "monthly_means"
)

new_agent <- function() {
  ag <- new_chat(system_prompt = "You are a careful data analyst working with
    the airquality dataset. Use your tools to get numbers. Never guess a number.")
  ag$register_tool(tool_monthly_means)
  ag
}

